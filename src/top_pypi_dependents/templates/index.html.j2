{% extends "base.html.j2" %}
{% block title %}Top PyPI Dependents{% endblock %}
{% block description %}Every PyPI project ranked by how many other projects declare an unconditional runtime dependency on it.{% endblock %}
{% block content %}
<h1>Top PyPI Dependents</h1>
<p class="lede">PyPI projects ranked by how many other projects declare an unconditional
runtime dependency on them, read from each project's latest release.</p>

<svg class="ornament" width="120" height="16" viewBox="0 0 120 16" fill="none"
    stroke="currentColor" aria-hidden="true">
  <path d="M0 8h46" stroke-width="1"/>
  <path d="M52 8c4-6 12-6 16 0-4 6-12 6-16 0z" stroke-width="1"/>
  <path d="M52 8h16" stroke-width="0.6"/>
  <path d="M74 8h46" stroke-width="1"/>
</svg>

{# The counts live one element down, in the line that reports them as state.
  What this has to say is the part a reader cannot infer: the filter reaches
  past the page. #}
<p class="hint" id="filter-hint">Searches every ranked project, not just the ones
  listed here.</p>
{# The field and the count travel together, and on a phone they stay put: with a
  keyboard open the viewport halves, and results that render below a screenful of
  masthead are results nobody can read while typing. #}
<div class="search">
<label class="label" for="filter">Filter</label>
<input id="filter" type="search" placeholder="Project name" autocomplete="off"
  aria-describedby="filter-hint">

<p class="count">Showing <span id="shown">{{ "{:,}".format(rows | length) }}</span>
  of {{ "{:,}".format(row_count) }} ranked projects.</p>
</div>

{# Two different answers to an empty table, and they must not be confused: the
  index is still arriving, or the project is genuinely not ranked. #}
<p class="note" id="beyond-note" hidden></p>

<p class="note" id="empty" hidden>Not ranked. Every project with at least
  {{ min_dependents }} dependent{{ "s" if min_dependents != 1 else "" }} is in
  <a href="latest.json">latest.json</a>.</p>

{# One polite region for the whole page. The visible count updates instantly;
  this announces the same thing on a delay, so a screen reader is not read a new
  total on every keystroke. #}
<p class="sr-only" id="announce" role="status"></p>

<table id="rows" data-on-page="{{ on_page }}" data-ranked="{{ row_count }}"{% if show_change %} data-show-change{% endif %}>
  <caption class="sr-only">PyPI projects in rank order, most depended on first.
    Dependents counts unconditional runtime dependencies; Incl. extras counts
    every declared one.</caption>
  <thead>
    <tr>
      {# "#" announces as "number sign". The column holds the answer this page
        exists to give, so it says its own name. #}
      <th class="num" scope="col"><span aria-hidden="true">#</span><span class="sr-only">Rank</span></th>
      <th scope="col">Project</th>
      <th class="num" scope="col">Dependents</th>
      <th class="num hide-narrow" scope="col">Incl. extras</th>
      {% if show_change %}
      <th class="num hide-narrow" scope="col">Change</th>
      {% endif %}
    </tr>
  </thead>
  <tbody id="page-rows">
  {% for row in rows %}
    <tr data-name="{{ row.project }}">
      <td class="num rank">{{ "{:,}".format(row.rank) }}</td>
      <td><a href="https://pypi.org/project/{{ row.project }}/" target="_blank" rel="noopener" aria-describedby="new-tab">{{ row.project }}</a></td>
      <td class="num">{{ "{:,}".format(row.dependents) }}</td>
      <td class="num hide-narrow">{{ "{:,}".format(row.dependents_all) }}</td>
      {% if show_change %}
      <td class="num move hide-narrow">
      {%- if row.rank_change is none %}<span class="new">new</span>
      {%- elif row.rank_change > 0 %}<span class="up">&#9650; <span class="sr-only">up </span>{{ row.rank_change }}</span>
      {%- elif row.rank_change < 0 %}<span class="dn">&#9660; <span class="sr-only">down </span>{{ -row.rank_change }}</span>
      {%- else %}<span class="flat">&ndash;<span class="sr-only">unchanged</span></span>{% endif -%}
      </td>
      {% endif %}
    </tr>
  {% endfor %}
  </tbody>
  {# Filled from search-index.json with matches ranked past this page. #}
  <tbody id="beyond"></tbody>
</table>

<h2>How it is counted</h2>
<p>One release per project &mdash; the latest final release by PEP&nbsp;440 ordering. The
ranked number counts only <em>unconditional runtime</em> dependencies; anything gated
behind an <code>extra</code> is counted separately, under &ldquo;incl. extras&rdquo;. Only
projects
still live on PyPI are ranked, and only live projects count as dependents.</p>
<p>More on <a href="data.html">how this is counted, what it cannot tell you, and how to
query the full dependency graph</a>.</p>
<script type="module" src="{{ asset("rankings.js") }}"></script>
{% endblock %}
