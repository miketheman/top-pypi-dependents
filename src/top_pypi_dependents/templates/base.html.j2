<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Top PyPI Dependents{% endblock %}</title>
{# Pasted into a chat window this is otherwise a bare URL, and a chat window is
  where a link to this gets shared. #}
<meta name="description" content="{% block description %}Which PyPI projects the rest of PyPI depends on, ranked by how many other projects declare a runtime dependency on them. Refreshed monthly from PyPI's own metadata.{% endblock %}">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:type" content="website">
{# The leaf from the ornament, inline rather than a file: a second request would
  break the promise that a page is self-contained, and an absent icon is a 404
  on every visit plus a blank square in the tab. Two of them, because a tab
  strip has a theme too and the dark accent disappears against a dark one. #}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M4 16c6-9 18-9 24 0-6 9-18 9-24 0z' fill='none' stroke='%233f5a3a' stroke-width='2'/%3E%3Cpath d='M4 16h24' fill='none' stroke='%233f5a3a' stroke-width='1.2'/%3E%3C/svg%3E">
<link rel="icon" media="(prefers-color-scheme: dark)" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M4 16c6-9 18-9 24 0-6 9-18 9-24 0z' fill='none' stroke='%23a2c087' stroke-width='2'/%3E%3Cpath d='M4 16h24' fill='none' stroke='%23a2c087' stroke-width='1.2'/%3E%3C/svg%3E">
<link rel="stylesheet" href="{{ asset("site.css") }}">
{# Ahead of the head block: a browser without merged import maps ignores one
  that follows a modulepreload. #}
<script type="importmap">{{ importmap | tojson }}</script>
{% block head %}{% endblock %}
</head>
<body{% block body_attrs %}{% endblock %}>
<a class="skip" href="#content">Skip to content</a>
<span id="new-tab" hidden>Opens in a new tab</span>
{# Two links styled identically gave a two-page site no wayfinding at all
  beyond its own h1. #}
<nav>
  <a href="index.html"{% if page == "rankings" %} aria-current="page"{% endif %}>Rankings</a>
  {% if has_cascade %}
  <a href="cascade.html"{% if page == "cascade" %} aria-current="page"{% endif %}>Cascade</a>
  {% endif %}
  <a href="data.html"{% if page == "data" %} aria-current="page"{% endif %}>Data</a>
</nav>
<main id="content">
{% block content %}{% endblock %}
</main>
<footer>
  <p class="meta">Generated {{ generated_at }} from
    {%- if source_url %} <a href="{{ source_url }}" target="_blank" rel="noopener" aria-describedby="new-tab">{{ source }}</a>
    {%- else %} {{ source }}{% endif %}.</p>
  <p class="meta">Ranked from {{ "{:,}".format(project_count) }} projects and {{ "{:,}".format(edge_count) }} dependency edges.</p>
  <p class="meta">{{ "{:,}".format(row_count) }} projects with at least {{ min_dependents }} dependent{{ "s" if min_dependents != 1 else "" }} are listed.</p>
</footer>
</body>
</html>
