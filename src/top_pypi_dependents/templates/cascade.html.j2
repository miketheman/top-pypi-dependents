{% extends "base.html.j2" %}
{% block title %}Dependency cascade · Top PyPI Dependents{% endblock %}
{% block description %}Every ranked PyPI project as one graph. A release lights up the projects that depend on it, and the projects that depend on those.{% endblock %}
{% block body_attrs %} class="app"{% endblock %}
{% block head %}
<link rel="stylesheet" href="{{ asset("cascade.css") }}">
{# Fetched as soon as the page is parsed, not after the script and its imports
  have each made a round trip. #}
<link rel="preload" href="{{ graph_url }}" as="fetch" crossorigin>
<link rel="modulepreload" href="{{ asset("format.js") }}">
<link rel="modulepreload" href="{{ asset("graph-model.js") }}">
{% endblock %}
{% block content %}
<header class="app-head">
  <h1>Dependency cascade</h1>
  <p>Every ranked project and the dependencies between them. Click a project to trace what it depends on and what depends on it.</p>
</header>

<div class="stage">
  <div class="surface" id="surface" data-graph="{{ graph_url }}" tabindex="0" role="application"
    aria-label="Dependency graph. Arrow keys pan, plus and minus zoom, 0 shows the whole graph. Use the search field to find a project and trace it."
    aria-describedby="status">
    <canvas id="gl" aria-hidden="true"></canvas>
    <canvas id="labels" aria-hidden="true"></canvas>
  </div>
  <p class="loading" id="status" role="status">Loading the graph…</p>
  <div class="tip" id="tip" hidden></div>

  <div class="panel controls">
    <label class="label" for="find">Find a project</label>
    <input id="find" type="search" placeholder="Find a project" autocomplete="off"
      enterkeyhint="go" aria-describedby="find-note">
    <div class="toggles">
      <label class="toggle"><input id="extras" type="checkbox"> Include extras</label>
      <label class="toggle"><input id="clouds" type="checkbox" checked> Clouds</label>
      <label class="toggle"><input id="direct" type="checkbox"> Direct only</label>
      <label class="toggle"><input id="animate" type="checkbox"> Animate</label>
      <label class="toggle" id="simulate-toggle" hidden><input id="simulate" type="checkbox"> Simulate releases</label>
    </div>
    <p class="note" id="find-note" hidden></p>
    <ol class="ticker" id="releases" aria-label="Simulated releases"></ol>
  </div>

  <section class="panel detail" id="detail" aria-labelledby="detail-name" hidden></section>

  <details class="panel key" id="key" open>
    <summary class="label">Key</summary>
    <ul class="meta">
      <li><svg width="36" height="8" aria-hidden="true"><defs><linearGradient id="lg-dir" gradientUnits="userSpaceOnUse" x1="0" x2="32" y1="0" y2="0"><stop offset="0" stop-color="currentColor" stop-opacity="0.1"/><stop offset="1" stop-color="currentColor"/></linearGradient></defs><path d="M0 4h32" stroke="url(#lg-dir)" stroke-width="1.5"/><circle cx="32" cy="4" r="3" fill="currentColor"/></svg>Strengthens toward the project depended on</li>
      <li><svg width="36" height="8" aria-hidden="true"><path d="M0 4h36" style="stroke: var(--accent)" stroke-width="2"/></svg>Depends on the selection</li>
      <li><svg width="36" height="8" aria-hidden="true"><path d="M0 4h36" style="stroke: var(--ink)" stroke-width="2" stroke-dasharray="4 3"/></svg>The selection depends on it</li>
    </ul>
    <p>A dot's size is its dependent count. Only projects with at least {{ graph_min_dependents }} dependents are drawn (counting extras when they are switched on), so a trace reaches a project's drawn dependents, not every one{% if hub %}: {{ hub.name }} has {{ "{:,}".format(hub.dependents) }} dependents, and the {{ "{:,}".format(hub.drawn) }} drawn are those with at least {{ graph_min_dependents }} of their own{% endif %}. Projects that share a name prefix, like <code>odoo-*</code>, are drawn near each other. <a href="data.html">How it is counted</a>.</p>
    <details class="clouds" id="cloud-key" hidden>
      <summary class="label">Clouds</summary>
      <p>Where projects crowd together. Each is named for what lives there; choose one to go to it.</p>
      <ul id="cloud-list"></ul>
    </details>
  </details>

  <div class="panel navigator">
    <canvas id="minimap" aria-hidden="true"></canvas>
    <div class="zoom">
      <button class="icon" id="zoom-in" type="button" aria-label="Zoom in">+</button>
      <button class="icon" id="zoom-out" type="button" aria-label="Zoom out">−</button>
      <button class="icon" id="zoom-fit" type="button" aria-label="Show the whole graph">⤢</button>
    </div>
  </div>
</div>

<script type="module" src="{{ asset("cascade.js") }}"></script>
{% endblock %}
