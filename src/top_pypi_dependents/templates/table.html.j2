{% extends "base.html.j2" %}
{% block title %}PyPI Dependents Rankings{% endblock %}
{% block content %}
<h1>Rankings</h1>
<p class="lede">PyPI projects ranked by how many other projects declare an unconditional
runtime dependency on them, read from each project's latest release.</p>

<svg class="ornament" width="120" height="16" viewBox="0 0 120 16" fill="none"
    stroke="currentColor" aria-hidden="true">
  <path d="M0 8h46" stroke-width="1"/>
  <path d="M52 8c4-6 12-6 16 0-4 6-12 6-16 0z" stroke-width="1"/>
  <path d="M52 8h16" stroke-width="0.6"/>
  <path d="M74 8h46" stroke-width="1"/>
</svg>

<p class="hint" id="filter-hint">Searches all {{ "{:,}".format(rows | length) }} rows on
  this page, including the ones not shown. Your browser's find-in-page sees only the
  visible ones.</p>
<label class="label" for="filter">Filter</label>
<input id="filter" type="search" placeholder="Project name" autocomplete="off"
  aria-describedby="filter-hint">

<p class="steps">Showing <span id="shown">{{ "{:,}".format(initial) }}</span> of
  {{ "{:,}".format(rows | length) }}.
  {% for step in steps[1:] %}
  <button type="button" data-limit="{{ step }}">Show {{ "{:,}".format(step) }}</button>
  {% endfor %}
</p>

<p class="steps" id="empty" hidden>No match in the top
  {{ "{:,}".format(rows | length) }}. All {{ "{:,}".format(row_count) }} ranked projects
  are in <a href="latest.json">latest.json</a>.</p>

{# One polite region for the whole page. The visible count updates instantly;
  this announces the same thing on a delay, so a screen reader is not read a new
  total on every keystroke. #}
<p class="sr-only" id="announce" role="status"></p>

<table id="rows">
  <thead>
    <tr>
      <th class="num">#</th>
      <th>Project</th>
      <th class="num">Dependents</th>
      <th class="num hide-narrow">Incl. extras</th>
      <th class="num">Change</th>
    </tr>
  </thead>
  <tbody>
  {% for row in rows %}
    <tr data-name="{{ row.project }}"{% if loop.index > initial %} hidden{% endif %}>
      <td class="num rank">{{ row.rank }}</td>
      <td><a href="https://pypi.org/project/{{ row.project }}/">{{ row.project }}</a></td>
      <td class="num">{{ "{:,}".format(row.dependents) }}</td>
      <td class="num hide-narrow">{{ "{:,}".format(row.dependents_all) }}</td>
      <td class="num move">
      {%- if row.rank_change is none %}<span class="new">new</span>
      {%- elif row.rank_change > 0 %}<span class="up">&#9650; {{ row.rank_change }}</span>
      {%- elif row.rank_change < 0 %}<span class="dn">&#9660; {{ -row.rank_change }}</span>
      {%- else %}<span class="flat">&ndash;</span>{% endif -%}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
<script>
// Matches against data-name rather than a cell's text: position-independent,
// so inserting a column cannot silently make this filter the wrong one, and
// the value is already canonical lowercase so there is nothing to normalize
// per row.
//
// On the 10,000-row page this takes roughly 100ms for the first keystroke and
// up to ~250ms to clear. That cost is style and layout for 10,000 rows, not
// this loop -- rewriting it to toggle a single stylesheet rule instead was
// measured and made no reliable difference. If the latency ever matters,
// the answer is fewer rows on the page, not a cleverer filter.
//
// Filtering and the reveal limit share one pass, because they are the same
// decision: a row is visible if it matches and is within the limit. Two
// independent handlers each setting `hidden` would fight over every row.
//
// A search looks past the limit deliberately. Someone typing a name wants that
// project found whether or not it sits in the first hundred, and a search that
// silently only covered the visible rows would be worse than none.
const rows = Array.from(document.querySelectorAll("#rows tbody tr"));
const filter = document.getElementById("filter");
const shown = document.getElementById("shown");
const empty = document.getElementById("empty");
const announce = document.getElementById("announce");
const total = {{ rows | length }};
let limit = {{ initial }};
let announceTimer;

function apply() {
  const needle = filter.value.trim().toLowerCase();
  let visible = 0;
  for (const row of rows) {
    const matches = needle === "" || row.dataset.name.includes(needle);
    row.hidden = !matches || (needle === "" && visible >= limit);
    if (!row.hidden) { visible += 1; }
  }
  shown.textContent = visible.toLocaleString();
  // The page carries the largest step; the JSON carries every ranked project.
  // Without this, searching for something ranked past the page looks identical
  // to searching for something that is not ranked at all.
  empty.hidden = visible !== 0;

  // Debounced, because this fires on every keystroke and an undebounced live
  // region reads a new total per character typed. The visible count above is
  // already current; only the announcement waits.
  clearTimeout(announceTimer);
  announceTimer = setTimeout(() => {
    announce.textContent = visible === 0
      ? `No match in the top ${total.toLocaleString()}.`
      : `Showing ${visible.toLocaleString()} of ${total.toLocaleString()}.`;
  }, 400);
}

filter.addEventListener("input", apply);
for (const button of document.querySelectorAll("[data-limit]")) {
  button.addEventListener("click", () => {
    limit = Number(button.dataset.limit);
    apply();
  });
}
</script>
{% endblock %}
